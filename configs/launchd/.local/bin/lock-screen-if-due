#!/usr/bin/env bash
# Usage: lock-screen-if-due HH:MM [GRACE_MINUTES]
#
# Lock the screen, but only if the current time is within GRACE_MINUTES (default 5)
# after HH:MM. launchd replays calendar jobs that fell due while the Mac slept, so a
# job scheduled for 11:00 also fires when the lid is opened at 14:00. Without the time
# check that replay would blank a screen the user had just unlocked.
#
# Display sleep locks the session only because screen lock is configured to require a
# password immediately (`sysadminctl -screenLock status`). Unlike synthesising
# Cmd-Ctrl-Q with osascript, it needs no Accessibility permission for the caller.
set -euo pipefail

usage() {
    echo "usage: $(basename "$0") HH:MM [GRACE_MINUTES]" >&2
    exit 64
}

# Minutes since midnight for H:MM or HH:MM. The 10# prefix stops bash from reading
# 08 or 09 as octal.
to_minutes() {
    local hh=${1%%:*} mm=${1##*:}
    echo $(( 10#$hh * 60 + 10#$mm ))
}

# Minutes elapsed since the scheduled time, wrapping at midnight so that a schedule
# of 23:58 is still due at 00:01.
minutes_since() {
    local scheduled=$1 now=$2
    echo $(( (now - scheduled + 1440) % 1440 ))
}

if [[ $# -lt 1 || $# -gt 2 || ! ${1:-} =~ ^[0-9]{1,2}:[0-9]{2}$ ]]; then
    usage
fi

scheduled=$(to_minutes "$1")
grace=${2:-5}
now=$(to_minutes "$(date +%H:%M)")
elapsed=$(minutes_since "$scheduled" "$now")

if (( elapsed >= grace )); then
    echo "not due: $1 was ${elapsed}m ago (grace ${grace}m)" >&2
    exit 0
fi

exec /usr/bin/pmset displaysleepnow
