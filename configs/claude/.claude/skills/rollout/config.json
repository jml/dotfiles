{
  "me": "jml",
  "review_gated_checks": [
    "doc-approval",
    "cg-codeowners-check"
  ],
  "deploys": {
    "chainguard-dev/mono": {
      "staging": "provision-chainops.dev.yaml",
      "prod": "provision-enforce.dev.yaml"
    },
    "chainguard-dev/data-analytics-infra": {
      "prod": "apply.yml"
    },
    "chainguard-dev/chainguard-devops": {
      "prod": "deploy.yaml"
    }
  },
  "stage_deploys": {
    "chainguard-dev/mono": {
      "staging": "provision-chainops.dev-stages.yaml",
      "prod": "provision-enforce.dev-stages.yaml"
    }
  },
  "chase": {
    "base_hours": 4,
    "lines_per_hour": 250,
    "max_hours": 16,
    "ignore_authors": [
      "chainguard",
      "github-actions"
    ]
  },
  "publish_artifact": false,
  "eod": {
    "stale_draft_days": 7,
    "hold_days": 7
  }
}
